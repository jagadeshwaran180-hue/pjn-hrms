{
  "typescript.tsdk": "web/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Tell TS language service to use the web tsconfig explicitly
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.preferences.importModuleSpecifier": "relative",

  // Formatter
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },

  // Suppress errors from folders that don't have TypeScript yet
  "typescript.validate.enable": true,

  // File associations
  "files.associations": {
    "*.tsx": "typescriptreact",
    "*.ts": "typescript"
  },

  // Exclude backend/mobile/database from TS language service
  "typescript.preferences.includeCompletionsWithSnippetText": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist_check": true,
    "mobile/**": false,
    "backend/**": false
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dist_check": true
  },

  // Tailwind intellisense
  "tailwindCSS.experimental.classRegex": [
    ["className\\s*=\\s*['\"`]([^'`\"]*)['\"`]"]
  ],

  // Emmet in tsx
  "emmet.includeLanguages": {
    "typescriptreact": "html"
  }
}
