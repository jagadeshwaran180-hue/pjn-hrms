{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "typeRoots": [
      "./web/node_modules/@types"
    ],
    "paths": {
      "react": ["./web/node_modules/@types/react"],
      "react-dom": ["./web/node_modules/@types/react-dom"],
      "react/jsx-runtime": ["./web/node_modules/@types/react/jsx-runtime"],
      "*": ["./web/node_modules/*"]
    }
  },
  "include": [
    "web/src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
