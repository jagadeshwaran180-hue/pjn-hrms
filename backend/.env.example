# ==============================================================================
# PJN TECH HRMS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables as per your local/deployment environment.
# Note: Never commit secrets or actual production credentials to version control.
# ==============================================================================

# Database Configuration (PostgreSQL managed by Trupthi)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_db
DB_USER=postgres
DB_PASSWORD=postgres

# Spring Profile & Behavior
SPRING_PROFILES_ACTIVE=dev
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Server Port
SERVER_PORT=8080
